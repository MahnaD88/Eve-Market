[
  {
    "name": "get_sell_orders",
    "title": "Get sell orders",
    "description": "Get public regional sell orders, cheapest first. Supply name or type_id. system_name filters a solar system, not a station. top is capped at 100.",
    "inputSchema": {
      "$defs": {
        "SellOrdersInput": {
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "properties": {
                "type_id": {
                  "type": "integer"
                }
              },
              "required": [
                "type_id"
              ]
            }
          ],
          "properties": {
            "name": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "type_id": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Type Id"
            },
            "region_name": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Region Name"
            },
            "system_name": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "System Name"
            },
            "cheapest": {
              "default": false,
              "title": "Cheapest",
              "type": "boolean"
            },
            "top": {
              "default": 10,
              "maximum": 100,
              "minimum": 1,
              "title": "Top",
              "type": "integer"
            }
          },
          "title": "SellOrdersInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/SellOrdersInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "get_sell_ordersArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Unmodified backend JSON, including all completeness and error details",
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "description": "Adapter context; never replaces backend warnings",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "data"
      ],
      "title": "AdapterResponse",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_market_history",
    "title": "Get regional market history",
    "description": "Get daily regional market history and summary. days limits latest available records; omit for all available history. This is regional volume, not station liquidity.",
    "inputSchema": {
      "$defs": {
        "HistoryInput": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Name",
              "type": "string"
            },
            "region_name": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Region Name",
              "type": "string"
            },
            "days": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Days"
            }
          },
          "required": [
            "name",
            "region_name"
          ],
          "title": "HistoryInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/HistoryInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "get_market_historyArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Unmodified backend JSON, including all completeness and error details",
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "description": "Adapter context; never replaces backend warnings",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "data"
      ],
      "title": "AdapterResponse",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
